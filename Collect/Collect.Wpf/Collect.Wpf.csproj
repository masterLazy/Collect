<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>res\icon.ico</ApplicationIcon>
    <AssemblyTitle>Collect</AssemblyTitle>
    <AssemblyName>Collect</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="res\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LazyWpf" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Collect.Core\Collect.Core.csproj" />
  </ItemGroup>

  <!--
    Copies the built React frontend (chakra-app/build) into the output directory
    as chakra-app/, which CollectHost uses as WebRootPath at runtime
    (see MainWindow.xaml.cs -> CollectHost.StartAsync).

    Runs after every Build for all configurations (Debug/Release). The frontend
    itself must be built manually first (cd chakra-app && npm run build); if it
    hasn't been built yet, this target is skipped without error.
  -->
  <Target Name="CopyFrontendToOutput" AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\chakra-app\build')">

    <!-- Remove stale hashed assets (old JS/CSS bundles) from a previous build. -->
    <RemoveDir Directories="$(TargetDir)chakra-app\static"
               Condition="Exists('$(TargetDir)chakra-app\static')" />

    <ItemGroup>
      <_FrontendBuildFiles Include="$(MSBuildProjectDirectory)\..\..\chakra-app\build\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_FrontendBuildFiles)"
          DestinationFiles="@(_FrontendBuildFiles->'$(TargetDir)chakra-app\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="high"
             Text="Frontend build copied to $(TargetDir)chakra-app (from chakra-app/build)." />
  </Target>

</Project>
